fb-logo:hover .fb-lid {\n            animation: none;\n          }\n        }\n      </style><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 500\" width=\"36\" height=\"36\" role=\"img\" aria-label=\"Frustrated Box Icon\" class=\"fb-body overflow-visible\"><defs><style>\n            .stroke { \n              fill: none; \n              stroke: #ff1a1a; \n              stroke-width: 9; \n              stroke-linecap: round; \n              stroke-linejoin: round; \n            }\n            /* Inner components to map on CSS anim classes */\n            .fb-bubble-bg {\n              fill: #000;\n            }\n          </style><filter id=\"frust-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\"><feGaussianBlur stdDeviation=\"1\" result=\"blur\"></feGaussianBlur><feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\"></feComposite></filter></defs><path class=\"stroke fb-lid fb-cracks\" filter=\"url(#frust-glow)\" d=\"M300 194 C335 194 350 215 350 240 V258 C350 280 340 305 323 333 L296 312 L252 298\"></path><g class=\"fb-cracks\"><path class=\"stroke fb-bubble-bg\" d=\"M190 164 H262 A38 38 0 0 1 300 202 V234 A38 38 0 0 1 262 272 H238 L178 300 L192 267 Q152 255 152 234 V202 A38 38 0 0 1 190 164 Z\"></path><path class=\"stroke\" d=\"M184 192 L214 206 M268 192 L238 206\"></path><circle cx=\"204\" cy=\"222\" r=\"7\" fill=\"#ff1a1a\"></circle><circle cx=\"248\" cy=\"222\" r=\"7\" fill=\"#ff1a1a\"></circle><path class=\"stroke\" d=\"M202 252 L214 244 L226 252 L238 244 L250 252\"></path></g></svg><span class=\"font-black text-xl tracking-tighter text-white flex items-center\">Frustrated<span class=\"text-red-600 -skew-x-6 ml-0.5\">Box</span></span></div></a></div><nav class=\"flex flex-col gap-1.5\" aria-label=\"Main Navigation\"><a class=\"group flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-all text-zinc-300 hover:bg-zinc-900/60 hover:text-white\" href=\"/\"><div class=\"flex items-center gap-3.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-house lucide-home h-5 w-5 shrink-0 transition-transform group-hover:scale-110 text-zinc-400 group-hover:text-zinc-200\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"></path><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg><span>Home</span></div></a><a class=\"group flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-all text-zinc-300 hover:bg-zinc-900/60 hover:text-white\" href=\"/explore\"><div class=\"flex items-center gap-3.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-compass h-5 w-5 shrink-0 transition-transform group-hover:scale-110 text-zinc-400 group-hover:text-zinc-200\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z\"></path></svg><span>Explore</span></div></a><a class=\"group flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-all text-zinc-300 hover:bg-zinc-900/60 hover:text-white\" href=\"/post\"><div class=\"flex items-center gap-3.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-plus lucide-plus-circle h-5 w-5 shrink-0 transition-transform group-hover:scale-110 text-zinc-400 group-hover:text-zinc-200\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M8 12h8\"></path><path d=\"M12 8v8\"></path></svg><span>Post</span></div></a><a class=\"group flex items-center justify-between rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-all text-zinc-300 hover:bg-zinc-900/60 hover:text-white\" href=\"/communities\"><div class=\"flex items-center gap-3.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5 shrink-0 transition-transform group-hover:scale-110 text-zinc-400 group-hover:text-zinc-200\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg><span>Communities</span></div></a></nav></div><div class=\"relative pt-3\"><div class=\"rounded-xl border border-zinc-800/80 bg-zinc-900/40 p-3\"><p class=\"text-xs font-semibold text-zinc-300\">Got frustration?</p><p class=\"mt-0.5 text-[11px] text-zinc-500\">Log in to save vents and join communities.</p><div class=\"mt-2.5 flex items-center gap-2\"><a class=\"flex-1 rounded-lg border border-zinc-800 bg-zinc-900 py-1.5 text-center text-xs font-medium text-zinc-300 transition hover:bg-zinc-800 hover:text-white\" href=\"/login\">Log In</a><a class=\"flex-1 rounded-lg border border-red-800/60 bg-red-950/40 py-1.5 text-center text-xs font-semibold text-red-200 transition hover:bg-red-900/60 hover:text-white\" href=\"/register\">Sign Up</a></div></div></div></aside><div class=\"min-h-screen min-w-0 flex-1 border-zinc-800/60 lg:border-x max-w-2xl xl:max-w-3xl\"><div class=\"hSr0oW_variable OTcHrW_variable min-h-screen bg-black text-zinc-300 font-family-name--font-display\"><header class=\"border-b border-zinc-800\"><div class=\"mx-auto flex max-w-5xl items-center justify-between px-5 py-4\"><a class=\"flex items-center gap-1 text-sm text-zinc-400 hover:text-white focus-visible:outline  focus-visible:outline-red-500\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg>FrustratedBox</a><span class=\"text-sm text-zinc-500\">Updated October 2026</span></div></header><main class=\"mx-auto max-w-5xl px-5 pt-14 pb-24\"><h1 class=\"font-(family-name:--font-display) text-5xl font-black leading-[0.95] tracking-tighter text-white sm:text-7xl\">Terms of<br/>Service</h1><p class=\"mt-6 max-w-[52ch] text-lg leading-relaxed text-zinc-400\">By using FrustratedBox you agree to the terms below. They exist so people can vent freely without anyone getting hurt.</p><aside role=\"note\" class=\"mt-12 bg-red-600 px-6 py-6 text-black sm:px-8\"><p class=\"font-(family-name:--font-display) text-2xl font-black leading-tight sm:text-3xl\">FrustratedBox is not therapy or crisis support.</p><p class=\"mt-3 max-w-[60ch] text-[17px] leading-relaxed text-black/85\">If you are thinking about harming yourself, or you&#x27;re in a medical emergency, contact your local emergency services or a crisis hotline right now. People here can listen, but they can&#x27;t keep you safe.</p></aside><div class=\"mt-16 grid gap-12 lg:grid-cols-[13rem_1fr]\"><nav aria-label=\"On this page\" class=\"hidden lg:block\"><ul class=\"sticky top-8 space-y-3 border-l border-zinc-800 pl-4 text-sm\"><li><a href=\"#eligibility\" class=\"text-zinc-500 hover:text-red-500 focus-visible:outline-2 focus-visible:outline-red-500\">Eligibility</a></li><li><a href=\"#conduct\" class=\"text-zinc-500 hover:text-red-500 focus-visible:outline-2 focus-visible:outline-red-500\">What you can&#x27;t post</a></li><li><a href=\"#ownership\" class=\"text-zinc-500 hover:text-red-500 focus-visible:outline-2 focus-visible:outline-red-500\">Your content and anonymity</a></li><li><a href=\"#moderation\" class=\"text-zinc-500 hover:text-red-500 focus-visible:outline-2 focus-visible:outline-red-500\">Moderation and bans</a></li><li><a href=\"#liability\" class=\"text-zinc-500 hover:text-red-500 focus-visible:outline-2 focus-visible:outline-red-500\">Disclaimers</a></li><li><a href=\"#contact\" class=\"text-zinc-500 hover:text-red-500 focus-visible:outline-2 focus-visible:outline-red-500\">Report a violation</a></li></ul></nav><div class=\"max-w-[68ch] divide-y divide-zinc-800\"><section id=\"eligibility\" class=\"scroll-mt-8 pb-10\"><h2 class=\"font-[family-name:var(--font-display)] text-xl font-extrabold tracking-tight text-white\">1. Eligibility</h2><p class=\"text-[17px] leading-[1.75] text-zinc-400 mt-3\">You must be at least 13, or the age of majority where you live, to create an account or browse as a guest. If you don&#x27;t agree with these terms, stop using the service.</p></section><section id=\"conduct\" class=\"scroll-mt-8 py-10\"><h2 class=\"font-[family-name:var(--font-display)] text-xl font-extrabold tracking-tight text-white\">2. What you can&#x27;t post</h2><p class=\"text-[17px] leading-[1.75] text-zinc-400 mt-3\">Rants can be raw and honest. They can&#x27;t cause harm to real people. You agree not to post any of the following.</p><dl class=\"mt-6 divide-y divide-zinc-900 border-y border-zinc-900\"><div class=\"grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6\"><dt class=\"font-(family-name:--font-display) font-semibold text-red-500\">Personal information</dt><dd class=\"text-[16px] leading-relaxed text-zinc-400\">Real full names, private phone numbers, home or workplace addresses, personal emails, or photos shared without permission.</dd></div><div class=\"grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6\"><dt class=\"font-(family-name:--font-display) font-semibold text-red-500\">Harassment and threats</dt><dd class=\"text-[16px] leading-relaxed text-zinc-400\">Targeted intimidation, stalking, incitement to violence, or extortion aimed at an individual.</dd></div><div class=\"grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6\"><dt class=\"font-(family-name:--font-display) font-semibold text-red-500\">Defamation</dt><dd class=\"text-[16px] leading-relaxed text-zinc-400\">Unverified criminal accusations against real people or named small businesses.</dd></div><div class=\"grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6\"><dt class=\"font-(family-name:--font-display) font-semibold text-red-500\">Hate speech</dt><dd class=\"text-[16px] leading-relaxed text-zinc-400\">Abuse based on race, ethnicity, caste, religion, disability, gender, or sexual orientation.</dd></div><div class=\"grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-6\"><dt class=\"font-(family-name:--font-display) font-semibold text-red-500\">Illegal activity and spam</dt><dd class=\"text-[16px] leading-relaxed text-zinc-400\">Selling illegal substances, copyright theft, phishing, or running bots and automated spam.</dd></div></dl></section><section id=\"ownership\" class=\"scroll-mt-8 py-10\"><h2 class=\"font-[family-name:var(--font-display)] text-xl font-extrabold tracking-tight text-white\">3. Your content and anonymity</h2><p class=\"text-[17px] leading-[1.75] text-zinc-400 mt-3\">You keep ownership of what you post. By posting, you give FrustratedBox a worldwide, non-exclusive, royalty-free license to host, display, blur, and format it on the platform.</p><p class=\"text-[17px] leading-[1.75] text-zinc-400 mt-4\">Anonymous posting hides your identity from other users, not from us. We record network data such as IP addresses to keep the platform secure, and we will respond to valid legal orders when violent threats or serious crimes are involved.</p></section><section id=\"moderation\" class=\"scroll-mt-8 py-10\"><h2 class=\"font-[family-name:var(--font-display)] text-xl font-extrabold tracking-tight text-white\">4. Moderation and bans</h2><p class=\"text-[17px] leading-[1.75] text-zinc-400 mt-3\">Administrators and moderators can blur, hide, edit, or delete any post that puts people at risk. We may suspend or ban an account or IP address without notice for serious or repeated violations.</p></section><section id=\"liability\" class=\"scroll-mt-8 py-10\"><h2 class=\"font-[family-name:var(--font-display)] text-xl font-extrabold tracking-tight text-white\">5. Disclaimers</h2><p class=\"text-[17px] leading-[1.75] text-zinc-400 mt-3\">FrustratedBox is provided &quot;as is&quot; and &quot;as available,&quot; without warranties of any kind. We don&#x27;t verify claims made in user posts, and we aren&#x27; t responsible for distress caused by what other people write. To the fullest extent the law allows, FrustratedBox and its operators are not liable for indirect or punitive damages.</p></section><section id=\"contact\" class=\"scroll-mt-8 pt-10\"><h2 class=\"font-[family-name:var(--font-display)] text-xl font-extrabold tracking-tight text-white\">6. Report a violation</h2><p class=\"text-[17px] leading-[1.75] text-zinc-400 mt-3\">If a post breaks these terms or infringes your legal rights, email<!-- --> <a href=\"mailto:safety@frustratedbox.com\" class=\"text-red-500 underline underline-offset-4 hover:text-red-400 focus-visible:outline-2 focus-visible:outline-red-500\">safety@frustratedbox.com</a>.</p></section></div></div></main><footer class=\"border-t border-zinc-800 py-8\"><div class=\"mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-5 text-sm text-zinc-500\"><p>© 2026 FrustratedBox</p><div class=\"flex gap-6\"><a class=\"hover:text-white\" href=\"/privacy\">Privacy policy</a><a class=\"hover:text-white\" href=\"/rules\">Community rules</a></div></div></footer></div><!--$--><!--/$--></div><aside class=\"sticky top-0 hidden h-screen w-80 shrink-0 flex-col gap-4 overflow-y-auto px-4 py-4 xl:flex border-l border-zinc-900 bg-zinc-950/40\"><div class=\"relative\"><svg xmlns=\"http://www.w3.org/2
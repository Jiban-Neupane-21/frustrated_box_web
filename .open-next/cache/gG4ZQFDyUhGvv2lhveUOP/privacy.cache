{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/privacy/layout,_N_T_/privacy/page,_N_T_/privacy"},"segmentPaths":["/_tree","/_full","/privacy/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable dark h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/68d403cf9f2c68c5-s.p.012bmydply3go.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/75affa71d1e2f6a7-s.p.17-aodiw50953.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/3d-1vk5hzu5rq.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/3w-5s41913_cj.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/134ckxcdt9adv.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3mc6dra1m0098.js\"/><script src=\"/_next/static/chunks/2i51e627rllld.js\" async=\"\"></script><script src=\"/_next/static/chunks/39u3ld3zqxqqm.js\" async=\"\"></script><script src=\"/_next/static/chunks/3ertolydtjaa3.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0sl7ij0oop7gk.js\" async=\"\"></script><script src=\"/_next/static/chunks/29m3e5ukklugj.js\" async=\"\"></script><script src=\"/_next/static/chunks/3_kac7-355gb6.js\" async=\"\"></script><script src=\"/_next/static/chunks/0loaq4vh4pqyg.js\" async=\"\"></script><script src=\"/_next/static/chunks/3svbd2lam7f9c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2zl1jagt4r0th.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\"></script><title>Privacy Policy | FrustratedBox</title><meta name=\"description\" content=\"Learn how FrustratedBox manages anonymity, collects data, and protects user identity.\"/><link rel=\"icon\" href=\"/icon?5fd53f25b9012763\" type=\"image/png\" sizes=\"32x32\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full bg-[#050505] text-zinc-100 selection:bg-red-900/60 selection:text-red-200\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"flex min-h-screen flex-col bg-[#050505] text-zinc-100 selection:bg-red-900/60 selection:text-red-200\"><header class=\"sticky top-0 z-50 w-full border-b border-zinc-800/80 bg-[#050505]/80 backdrop-blur-md lg:hidden\"><div class=\"mx-auto flex h-16 max-w-6xl items-center gap-2 px-3 sm:gap-4 sm:px-6\"><a class=\"shrink-0 transition-transform hover:scale-[1.02]\" href=\"/\"><div class=\"fb-logo inline-flex items-center gap-2.5 select-none cursor-pointer [&amp;&gt;span]:hidden sm:[&amp;&gt;span]:inline\"><style>\n        /* Lid / Top face strain under pressure */\n        @keyframes fb-lid {\n          0%, 70%, 100% { transform: translateY(0) rotate(0deg); }\n          78% { transform: translateY(-2px) rotate(-1deg); }\n          86% { transform: translateY(-0.5px) rotate(-0.5deg); }\n          94% { transform: translateY(-1.5px) rotate(-1deg); }\n        }\n\n        /* SVG visual components behavior */\n        .fb-body {\n          transform-box: fill-box;\n          transform-origin: center;\n        }\n        .fb-logo:hover .fb-body {\n          animation: fb-shake 0.15s linear infinite;\n        }\n\n        .fb-lid {\n          transform-box: fill-box;\n          transform-origin: center;\n          animation: fb-lid 3.2s ease-in-out infinite;\n        }\n        .fb-logo:hover .fb-lid {\n          animation-duration: 0.6s;\n        }\n\n        /* Hover Glow transition on cracks */\n        .fb-cracks {\n          transition: filter 0.3s ease-in-out;\n        }\n        .fb-logo:hover .fb-cracks {\n          filter: drop-shadow(0 0 10px #ef4444) drop-shadow(0 0 20px #dc2626);\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n          .fb-lid,\n          .fb-logo:hover .fb-body,\n          .fb-logo:hover .fb-lid {\n            animation: none;\n          }\n        }\n      </style><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 500\" width=\"34\" height=\"34\" role=\"img\" aria-label=\"Frustrated Box Icon\" class=\"fb-body overflow-visible\"><defs><style>\n            .stroke { \n              fill: none; \n              stroke: #ff1a1a; \n              stroke-width: 9; \n              stroke-linecap: round; \n              stroke-linejoin: round; \n            }\n            /* Inner components to map on CSS anim classes */\n            .fb-bubble-bg {\n              fill: #000;\n            }\n          </style><filter id=\"frust-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\"><feGaussianBlur stdDeviation=\"1\" result=\"blur\"></feGaussianBlur><feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\"></feComposite></filter></defs><path class=\"stroke fb-lid fb-cracks\" filter=\"url(#frust-glow)\" d=\"M300 194 C335 194 350 215 350 240 V258 C350 280 340 305 323 333 L296 312 L252 298\"></path><g class=\"fb-cracks\"><path class=\"stroke fb-bubble-bg\" d=\"M190 164 H262 A38 38 0 0 1 300 202 V234 A38 38 0 0 1 262 272 H238 L178 300 L192 267 Q152 255 152 234 V202 A38 38 0 0 1 190 164 Z\"></path><path class=\"stroke\" d=\"M184 192 L214 206 M268 192 L238 206\"></path><circle cx=\"204\" cy=\"222\" r=\"7\" fill=\"#ff1a1a\"></circle><circle cx=\"248\" cy=\"222\" r=\"7\" fill=\"#ff1a1a\"></circle><path class=\"stroke\" d=\"M202 252 L214 244 L226 252 L238 244 L250 252\"></path></g></svg><span class=\"font-black text-xl tracking-tighter text-white flex items-center\">Frustrated<span class=\"text-red-600 -skew-x-6 ml-0.5\">Box</span></span></div></a><nav class=\"flex min-w-0 flex-1 items-center justify-evenly gap-1 md:justify-center md:gap-2\"><a aria-label=\"Home\" title=\"Home\" class=\"flex items-center justify-center gap-2 rounded-lg p-2 text-xs font-medium transition sm:text-sm md:px-3 md:py-1.5 text-zinc-400 hover:bg-zinc-900/60 hover:text-zinc-200\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-house lucide-home h-4 w-4 shrink-0\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"></path><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg><span class=\"hidden md:inline\">Home</span></a><a aria-label=\"Explore\" title=\"Explore\" class=\"flex items-center justify-center gap-2 rounded-lg p-2 text-xs font-medium transition sm:text-sm md:px-3 md:py-1.5 text-zinc-400 hover:bg-zinc-900/60 hover:text-zinc-200\" href=\"/explore\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-compass h-4 w-4 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z\"></path></svg><span class=\"hidden md:inline\">Explore</span></a><a aria-label=\"Post\" title=\"Post\" class=\"flex items-center justify-center gap-2 rounded-lg p-2 text-xs font-medi
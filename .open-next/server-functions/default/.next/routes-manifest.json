  "dynamicRoutes": [
    {
      "page": "/admin/communities/routes/[id]",
      "regex": "^/admin/communities/routes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/communities/routes/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/admin/user/routes/[id]",
      "regex": "^/admin/user/routes/([^/]+?)(?:/)?$",
